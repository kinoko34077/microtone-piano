# Shared specification and implementation: https://github.com/kinoko34077/devflow/issues/1088
# Bootstrap default: LF for portable text; native CRLF for Windows batch scripts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Audio assets are byte-exact media; do not apply text newline conversions.
*.m4a -text
*.ogg -text
*.wav -text
*.mp3 -text
*.flac -text
*.mid -text
